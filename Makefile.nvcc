CC = cc
NVCC = nvcc
CFLAGS = -g -Wall -Wextra -fopenmp -Wno-variadic-macros \
         -Wno-long-long
NVCCFLAGS = -ccbin ${CC} --compiler-options "${CFLAGS}" -g -O3
NVCCLDFLAGS = --compiler-options '-shared -fPIC'
CPPFLAGS =
FC = gfortran
FFLAGS = -g -Wall -Wextra -pedantic -std=f2008ts -fopenmp

OBJ = molecular_lines.o new.o device_launch.o host_launch.o \
      ozone_continuum.o water_vapor_continuum.o eval_profile.o \
      eval_snn_correction.o eval_pshift.o eval_gamma.o pre_eval_snn.o \
      integrate_layer.o line_shape_utils.o gas_properties.o RFM_voigt.o \
      ida_voigt.o doppler.o lorentz.o TIPS_2011.o parse_HITRAN_file.o \
      parse_csv.o molecules.o utils.o cuda_helpers.o
LIB_NAME = molecular_lines
STATIC_LIB = lib${LIB_NAME}.a
SHARED_LIB = lib${LIB_NAME}.so
LIB_MOD = ${LIB_NAME}.mod
LIBS = ${STATIC_LIB} ${SHARED_LIB}
PREFIX = .

TESTOBJ = example.o
TESTX = example.x
TESTFOBJ = examplef.o
TESTFX = examplef.x

all: ${LIBS}
test: ${TESTX} ${TESTFX}

${STATIC_LIB}: ${OBJ}
	ar rcs $@ $^
	ranlib $@

${SHARED_LIB}: ${OBJ}
	${NVCC} ${NVCCLDFLAGS} -o $@ $^ -lgfortran

%.o: src/%.c
	${NVCC} -x cu -dc ${NVCCFLAGS} ${NVCCLDFLAGS} ${CPPFLAGS} -o $@ -c $<

%.o: src/%.cu
	${NVCC} -x cu -dc ${NVCCFLAGS} ${NVCCLDFLAGS} ${CPPFLAGS} -o $@ -c $<

%.o: src/%.F90
	${FC} ${FFLAGS} -fPIC -o $@ -c $<

%.o: tests/%.c
	${NVCC} -x cu -dc ${NVCCFLAGS} ${NVCCLDFLAGS} ${CPPFLAGS} -Isrc -o $@ -c $<

%.o: tests/%.F90
	${FC} ${FFLAGS} -fPIC -o $@ -c $<

${TESTOBJ}: ${LIBS}
${TESTFOBJ}: ${LIBS}

${TESTX}: ${TESTOBJ} ${LIBS}
	${NVCC} ${NVCCFLAGS} -o $@ $< -L. -l${LIB_NAME} --linker-options "-rpath=."

${TESTFX}: ${TESTFOBJ} ${LIBS}
	${FC} ${FFLAGS} -o $@ $< -L. -l${LIB_NAME} -Wl,-rpath='$$ORIGIN'

install:
	install -d ${PREFIX}/include
	install -t ${PREFIX}/include ${LIB_MOD} src/${LIB_NAME}.h
	install -d ${PREFIX}/lib
	install -t ${PREFIX}/lib ${LIBS}

clean:
	rm -f ${LIBS} ${LIB_MOD} ${OBJ}
	rm -f ${TESTX} ${TESTOBJ} ${TESTFX} ${TESTFOBJ}
