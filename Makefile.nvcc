CC = cc
NVCC = nvcc
CFLAGS = '-g -O3 -fopenmp'
NVCCFLAGS = --compiler-options ${CFLAGS} -g -O3
NVCCLDFLAGS = --compiler-options '-shared -fPIC'

OBJ = grtcode.o write_output.o device_launch.o host_launch.o sw_flux.o lw_flux.o output_fields.o \
      eval_profile.o RfmVoigtFuncs.o IdaVoigtFuncs.o GaussianFuncs.o \
      eval_Snn_correction.o eval_pShift.o eval_gamma.o LorentzFuncs.o \
      pre_eval_Snn.o line_shape_utils.o GasProps.o integrate_layer.o \
      TIPS_2011.o water_vapor_continuum.o ozone_continuum.o solar_flux.o \
      parseHITRANfile.o input_fields.o model_fields.o \
      arguments.o molecules.o parse_csv.o query_gpu.o cudaHelpers.o utils.o constants.o
EXECUTABLE = grtcode.x

INCLUDE = -Isrc \
          -Ipackages/radiation_solvers/src \
          -Ipackages/netcdf-4.6.1/include
LDFLAGS = -Lpackages/netcdf-4.6.1/lib \
          -Lpackages/hdf5-1.10.1/lib
LIBS = packages/radiation_solvers/libradiation_solvers.a -lnetcdf -lhdf5 -lhdf5_hl -lm

RPATH = '-rpath=`readlink -f packages/netcdf-4.6.1/lib`'
RPATH2 = '-rpath=`readlink -f packages/hdf5-1.10.1/lib`'

all: ${EXECUTABLE}

${EXECUTABLE}: ${OBJ}
	${NVCC} ${NVCCFLAGS} -o $@ -Xlinker ${RPATH} -Xlinker ${RPATH2} $^ ${LDFLAGS} ${LIBS}

%.o: src/%.c
	${NVCC} -x cu -dc ${NVCCLDFLAGS} ${NVCCFLAGS} --compiler-options ${INCLUDE} -o $@ -c $<

%.o: src/%.cu
	${NVCC} -x cu -dc ${NVCCLDFLAGS} ${NVCCFLAGS} --compiler-options ${INCLUDE} -o $@ -c $<

clean:
	rm -f *.o *.x
